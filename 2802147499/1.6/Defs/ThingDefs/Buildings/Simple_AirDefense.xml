<?xml version="1.0" encoding="utf-8"?>
<Defs>
 <ThingDef Abstract="True" Name="BaseWeaponAntiAir" ParentName="BaseWeapon">
    <destroyOnDrop>True</destroyOnDrop>
    <drawerType>MapMeshAndRealTime</drawerType>
    <canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
    <tradeability>None</tradeability>
    <useHitPoints>false</useHitPoints>
	<statBases>
      <AccuracyTouch>0.77</AccuracyTouch>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.45</AccuracyMedium>
      <AccuracyLong>0.24</AccuracyLong>
      <RangedWeapon_Cooldown>4.8</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>5</Mass>
      <Flammability>0</Flammability>
    </statBases>
	<tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>0</power>
        <cooldownTime>100</cooldownTime>
      </li>
     </tools>
    <weaponTags>
      <li>AntiAirWeaponGun</li>
    </weaponTags>
    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <allowedArchonexusCount>0</allowedArchonexusCount>
  </ThingDef>
 

	<ThingDef Abstract="True" Name="BaseBuildingAntiAir" ParentName="BuildingBase">
	    <thingClass>AntiAirWeapon.Buildings.Building_AirDefense</thingClass>
		<graphicData>
		  <texPath>AntiAirWeapon/Building/ADA_small_bottom</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		  <shadowData>
			<volume>(0.8, 0.3, 0.3)</volume>
			<offset>(0,0,-0.25)</offset>
		  </shadowData>
		  <drawSize>(3,3)</drawSize>
		</graphicData>
		<uiIconPath>AntiAirWeapon/Building/ADA_smallAirDefense_UI</uiIconPath>
		<uiIconScale>2</uiIconScale>
		<altitudeLayer>Building</altitudeLayer>
		<size>(2,2)</size>
		<statBases>
		  <MaxHitPoints>400</MaxHitPoints>
		  <WorkToBuild>2500</WorkToBuild>
		  <Flammability>0.3</Flammability>
		  <Mass>8</Mass>
		  <Beauty>-6</Beauty>
		</statBases>
		<drawerType>MapMeshAndRealTime</drawerType>
		<drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
		<fillPercent>0.15</fillPercent>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<pathCost>8</pathCost>
		
		<researchPrerequisites>
		  <li>SimpleAntiAirWeapon</li>
		</researchPrerequisites>
		
		<designationCategory>Security</designationCategory>
		<rotatable>false</rotatable>
		<specialDisplayRadius>30</specialDisplayRadius>
		<tickerType>Normal</tickerType>
		<constructionSkillPrerequisite>7</constructionSkillPrerequisite>
		<comps>
		  
		  <li Class="CompProperties_Flickable" />
		  <li Class="CompProperties_Breakdownable" />
		  
		</comps>
	</ThingDef>


 
 <ThingDef ParentName="BaseWeaponAntiAir">
    <defName>Gun_AntiAirWeapon_Simple</defName>
    <label>AntiAirWeapon Simple gun</label>
    <description>A simple automatic gun made to be mounted on a turret.</description>
    <graphicData>
      <texPath>AntiAirWeapon/Building/ADA_smallAirDefense_top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>

  </ThingDef>
  
  
   <ThingDef ParentName="BaseWeaponAntiAir">
    <defName>Gun_AntiAirWeapon_Advance</defName>
    <label>AntiAirWeapon Advance gun</label>
    <description>A simple automatic gun made to be mounted on a turret.</description>
    <graphicData>
      <texPath>AntiAirWeapon/Building/ADA_middleAirDefense_top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>

  </ThingDef>
  
  
  <ThingDef ParentName="BaseBuildingAntiAir">
    <defName>AntiAirWeapon_Simple</defName>
    <label>Simple AntiAirWeapon</label>
    <description>It will hit enemy's mortar shells.</description>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
	  <Gold>6</Gold>
    </costList>
	
    <comps>
      <li Class="CompProperties_Power">
		<compClass>CompPowerTrader</compClass>
		<basePowerConsumption>400</basePowerConsumption>
		<shortCircuitInRain>false</shortCircuitInRain>
	  </li>
      <li Class="AntiAirWeapon.Buildings.CompProperties_TurretTopSize">
        <topSize>(2,2,2)</topSize>
		<soundShoot>ra2_SovietAirDefense_shot</soundShoot>
		<canShotProjectile>true</canShotProjectile>
		<canShotPod>false</canShotPod>
		<storeTick>180</storeTick>
		<atkRange>30</atkRange>
		<maxStoreBullet>2</maxStoreBullet>
      </li>
    </comps>
    <building>
	    <ai_combatDangerous>true</ai_combatDangerous>
        <turretGunDef>Gun_AntiAirWeapon_Simple</turretGunDef>
    </building>
  </ThingDef>
  
    <ThingDef ParentName="BaseBuildingAntiAir">
    <defName>AntiAirWeapon_Advance</defName>
    <label>Advance AntiAirWeapon</label>
    <description>It will hit enemy's Pod.</description>
	<uiIconPath>AntiAirWeapon/Building/ADA_middleAirDefense_UI</uiIconPath>
    <costList>
      <Steel>300</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
	  <Gold>20</Gold>
    </costList>
	<size>(3,3)</size>
	<graphicData>
	  <texPath>AntiAirWeapon/Building/ADA_middle_bottom</texPath>
	  <graphicClass>Graphic_Single</graphicClass>
	  <shadowData>
		<volume>(0.8, 0.3, 0.3)</volume>
		<offset>(0,0,-0.25)</offset>
	  </shadowData>
	  <drawSize>(3,3)</drawSize>
	</graphicData>
    <comps>
      <li Class="CompProperties_Power">
		<compClass>CompPowerTrader</compClass>
		<basePowerConsumption>1000</basePowerConsumption>
		<shortCircuitInRain>false</shortCircuitInRain>
	  </li>
      <li Class="AntiAirWeapon.Buildings.CompProperties_TurretTopSize">
        <topSize>(3,3,3)</topSize>
		<soundShoot>ra2_SovietAirDefense_shot</soundShoot>
		<canShotProjectile>false</canShotProjectile>
		<canShotPod>true</canShotPod>
		<storeTick>340</storeTick>
		<atkRange>30</atkRange>
		<maxStoreBullet>5</maxStoreBullet>
      </li>
    </comps>
	<researchPrerequisites>
	  <li>AdvanceAntiAirWeapon</li>
	</researchPrerequisites>
    <building>
	    <ai_combatDangerous>true</ai_combatDangerous>
        <turretGunDef>Gun_AntiAirWeapon_Advance</turretGunDef>
    </building>
  </ThingDef>
</Defs>